digraph "b2" {
  graph [rankdir=TB, fontname="Liberation Serif", fontsize=16, labelloc=t, label=<<B>Fig. 3. Módulo de planeación (secciones y disponibilidad)</B><BR/> >, nodesep=0.35, ranksep=0.6, compound=true, newrank=true, pad=0.3 , ranksep=0.7];
  node [shape=plain, fontname="Liberation Serif", fontsize=11];
  edge [fontname="Liberation Serif", fontsize=10, arrowsize=0.8];
  PlaneacionController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«RestController»<BR/><B>PlaneacionController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- planeacionService : PlaneacionService<BR ALIGN="LEFT"/></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD><TD ALIGN="LEFT">+ PlaneacionController(planeacionService : PlaneacionService)</TD></TR><TR><TD ALIGN="LEFT">GET /api/secciones</TD><TD ALIGN="LEFT">+ listarSecciones(idPeriodo : Integer, idCurso : Integer) : ResponseEntity&lt;List&lt;Seccion&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/secciones/{id}</TD><TD ALIGN="LEFT">+ obtenerSeccion(id : int) : ResponseEntity&lt;Seccion&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/secciones</TD><TD ALIGN="LEFT">+ crearSeccion(seccion : Seccion) : ResponseEntity&lt;Seccion&gt;</TD></TR><TR><TD ALIGN="LEFT">PUT /api/secciones/{id}</TD><TD ALIGN="LEFT">+ actualizarSeccion(id : int, seccion : Seccion) : ResponseEntity&lt;Seccion&gt;</TD></TR><TR><TD ALIGN="LEFT">PATCH /api/secciones/{id}/matricula-real</TD><TD ALIGN="LEFT">+ registrarMatriculaReal(id : int, body : Map&lt;String, Integer&gt;) : ResponseEntity&lt;Seccion&gt;</TD></TR><TR><TD ALIGN="LEFT">PATCH /api/secciones/{id}/cerrar</TD><TD ALIGN="LEFT">+ cerrarSeccion(id : int) : ResponseEntity&lt;Seccion&gt;</TD></TR><TR><TD ALIGN="LEFT">PATCH /api/secciones/{id}/estado</TD><TD ALIGN="LEFT">+ cambiarEstadoSeccion(id : int, body : Map&lt;String, String&gt;) : ResponseEntity&lt;Seccion&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/disponibilidad</TD><TD ALIGN="LEFT">+ listarDisponibilidad(idDocente : Integer, idPeriodo : Integer) : ResponseEntity&lt;List&lt;Disponibilidad&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/disponibilidad</TD><TD ALIGN="LEFT">+ registrarDisponibilidad(disponibilidad : Disponibilidad) : ResponseEntity&lt;Disponibilidad&gt;</TD></TR><TR><TD ALIGN="LEFT">PUT /api/disponibilidad</TD><TD ALIGN="LEFT">+ actualizarDisponibilidad(disponibilidad : Disponibilidad) : ResponseEntity&lt;Disponibilidad&gt;</TD></TR><TR><TD ALIGN="LEFT">DELETE /api/disponibilidad</TD><TD ALIGN="LEFT">+ eliminarDisponibilidad(idDocente : int, idPeriodo : int, idFranja : int) : ResponseEntity&lt;Map&lt;String, String&gt;&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  PlaneacionService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Service»<BR/><B>PlaneacionService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- planeacionRepository : PlaneacionRepository<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ PlaneacionService(planeacionRepository : PlaneacionRepository)<BR ALIGN="LEFT"/>+ listarSecciones(idPeriodo : Integer, idCurso : Integer) : List&lt;Seccion&gt;<BR ALIGN="LEFT"/>+ obtenerSeccionPorId(idSeccion : int) : Seccion<BR ALIGN="LEFT"/>+ crearSeccion(seccion : Seccion) : Seccion<BR ALIGN="LEFT"/>+ actualizarSeccion(idSeccion : int, seccion : Seccion) : Seccion<BR ALIGN="LEFT"/>+ registrarMatriculaReal(idSeccion : int, matriculaReal : int) : Seccion<BR ALIGN="LEFT"/>+ cerrarSeccion(idSeccion : int) : Seccion<BR ALIGN="LEFT"/>+ cambiarEstadoSeccion(idSeccion : int, estado : String) : Seccion<BR ALIGN="LEFT"/>+ listarDisponibilidad(idDocente : Integer, idPeriodo : Integer) : List&lt;Disponibilidad&gt;<BR ALIGN="LEFT"/>+ registrarDisponibilidad(disponibilidad : Disponibilidad) : Disponibilidad<BR ALIGN="LEFT"/>+ eliminarDisponibilidad(idDocente : int, idPeriodo : int, idFranja : int)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PlaneacionRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Repository»<BR/><B>PlaneacionRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dataSource : DataSource<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ PlaneacionRepository(dataSource : DataSource)<BR ALIGN="LEFT"/>+ listarSecciones(idPeriodo : Integer, idCurso : Integer) : List&lt;Seccion&gt;<BR ALIGN="LEFT"/>+ obtenerSeccionPorId(idSeccion : int) : Seccion<BR ALIGN="LEFT"/>+ crearSeccion(s : Seccion) : Seccion<BR ALIGN="LEFT"/>+ actualizarSeccion(idSeccion : int, s : Seccion) : Seccion<BR ALIGN="LEFT"/>+ registrarMatriculaReal(idSeccion : int, matriculaReal : int) : Seccion<BR ALIGN="LEFT"/>+ cambiarEstadoSeccion(idSeccion : int, estado : String) : Seccion<BR ALIGN="LEFT"/>+ listarDisponibilidad(idDocente : Integer, idPeriodo : Integer) : List&lt;Disponibilidad&gt;<BR ALIGN="LEFT"/>+ registrarDisponibilidad(d : Disponibilidad, idUsuario : int) : Disponibilidad<BR ALIGN="LEFT"/>+ eliminarDisponibilidad(idDocente : int, idPeriodo : int, idFranja : int, idUsuario : int)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PlaneacionController -> PlaneacionService [arrowhead=vee];
  PlaneacionService -> PlaneacionRepository [arrowhead=vee];
  PlaneacionRepository -> ext_DataSource [arrowhead=vee];
  AuthContextHolder [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5"><B>AuthContextHolder</B></TD></TR></TABLE>>];
  PlaneacionService -> AuthContextHolder [style=dashed, arrowhead=vee];
  PlaneacionRepository -> AuthContextHolder [style=dashed, arrowhead=vee];
  ext_DataSource [shape=box, style=dashed, fontname="Liberation Serif", fontsize=11, margin="0.12,0.06", label=<«interface»<BR/>javax.sql.DataSource>];
  subgraph cluster_model { label=<<B>model</B>: DTO que usa el módulo (atributos en la Fig. 7)>; fontsize=12; style=solid; margin=10;
    Disponibilidad [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Disponibilidad</B></TD></TR></TABLE>>];
    Seccion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Seccion</B></TD></TR></TABLE>>];
    { rank=same; Disponibilidad; Seccion; }
  }
  PlaneacionRepository -> Seccion [style=dashed, arrowhead=vee, lhead=cluster_model, label="«use»"];
  ext_DataSource -> Disponibilidad [style=invis];
}
