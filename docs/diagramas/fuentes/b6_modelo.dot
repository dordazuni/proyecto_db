  Disponibilidad [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Disponibilidad</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idDocente : Integer<BR ALIGN="LEFT"/>- nombreDocente : String<BR ALIGN="LEFT"/>- idPeriodo : Integer<BR ALIGN="LEFT"/>- idFranja : Integer<BR ALIGN="LEFT"/>- diaSemana : Integer<BR ALIGN="LEFT"/>- nombreDia : String<BR ALIGN="LEFT"/>- horaInicio : LocalTime<BR ALIGN="LEFT"/>- horaFin : LocalTime<BR ALIGN="LEFT"/>- tipo : String<BR ALIGN="LEFT"/>- idUsuario : Integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Docente [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Docente</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idDocente : Integer<BR ALIGN="LEFT"/>- tipoDocumento : String<BR ALIGN="LEFT"/>- numeroDocumento : String<BR ALIGN="LEFT"/>- nombres : String<BR ALIGN="LEFT"/>- apellidos : String<BR ALIGN="LEFT"/>- email : String<BR ALIGN="LEFT"/>- estadoVinculacion : String<BR ALIGN="LEFT"/>- idTipoContrato : Integer<BR ALIGN="LEFT"/>- nombreTipoContrato : String<BR ALIGN="LEFT"/>- horasMin : Integer<BR ALIGN="LEFT"/>- horasMax : Integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  DocenteCurso [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>DocenteCurso</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idDocente : Integer<BR ALIGN="LEFT"/>- nombreDocente : String<BR ALIGN="LEFT"/>- idCurso : Integer<BR ALIGN="LEFT"/>- codigoCurso : String<BR ALIGN="LEFT"/>- nombreCurso : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EchoResponse [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>EchoResponse</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- status : String<BR ALIGN="LEFT"/>- databaseConnected : boolean<BR ALIGN="LEFT"/>- message : String<BR ALIGN="LEFT"/>- databaseUrl : String<BR ALIGN="LEFT"/>- timestamp : LocalDateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Espacio [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Espacio</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idEspacio : Integer<BR ALIGN="LEFT"/>- codigo : String<BR ALIGN="LEFT"/>- nombre : String<BR ALIGN="LEFT"/>- capacidad : Integer<BR ALIGN="LEFT"/>- edificio : String<BR ALIGN="LEFT"/>- tipoEspacio : String<BR ALIGN="LEFT"/>- numeroEquipos : Integer<BR ALIGN="LEFT"/>- area : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EspacioRecurso [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>EspacioRecurso</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idEspacio : Integer<BR ALIGN="LEFT"/>- idRecurso : Integer<BR ALIGN="LEFT"/>- nombreRecurso : String<BR ALIGN="LEFT"/>- categoriaRecurso : String<BR ALIGN="LEFT"/>- cantidad : Integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Franja [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Franja</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idFranja : Integer<BR ALIGN="LEFT"/>- diaSemana : Integer<BR ALIGN="LEFT"/>- nombreDia : String<BR ALIGN="LEFT"/>- horaInicio : LocalTime<BR ALIGN="LEFT"/>- horaFin : LocalTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  HorarioDetalle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>HorarioDetalle</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idAsignacion : Integer<BR ALIGN="LEFT"/>- idVersion : Integer<BR ALIGN="LEFT"/>- numeroVersion : Integer<BR ALIGN="LEFT"/>- estadoVersion : String<BR ALIGN="LEFT"/>- idPeriodo : Integer<BR ALIGN="LEFT"/>- periodo : String<BR ALIGN="LEFT"/>- idSeccion : Integer<BR ALIGN="LEFT"/>- codigoCurso : String<BR ALIGN="LEFT"/>- nombreCurso : String<BR ALIGN="LEFT"/>- numeroSeccion : Integer<BR ALIGN="LEFT"/>- idDocente : Integer<BR ALIGN="LEFT"/>- docente : String<BR ALIGN="LEFT"/>- idEspacio : Integer<BR ALIGN="LEFT"/>- codigoEspacio : String<BR ALIGN="LEFT"/>- tipoEspacio : String<BR ALIGN="LEFT"/>- idFranja : Integer<BR ALIGN="LEFT"/>- diaSemana : Integer<BR ALIGN="LEFT"/>- nombreDia : String<BR ALIGN="LEFT"/>- horaInicio : LocalTime<BR ALIGN="LEFT"/>- horaFin : LocalTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LogAuditoria [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>LogAuditoria</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idLog : Long<BR ALIGN="LEFT"/>- idUsuario : Integer<BR ALIGN="LEFT"/>- nombreUsuario : String<BR ALIGN="LEFT"/>- fechaHora : OffsetDateTime<BR ALIGN="LEFT"/>- accion : String<BR ALIGN="LEFT"/>- tablaAfectada : String<BR ALIGN="LEFT"/>- detalle : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LoginRequest [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>LoginRequest</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nombreUsuario : String<BR ALIGN="LEFT"/>- contrasena : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LoginResponse [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>LoginResponse</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- token : String<BR ALIGN="LEFT"/>- usuario : Usuario<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ParametroSistema [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>ParametroSistema</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- clave : String<BR ALIGN="LEFT"/>- valor : BigDecimal<BR ALIGN="LEFT"/>- descripcion : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PeriodoAcademico [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>PeriodoAcademico</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idPeriodo : Integer<BR ALIGN="LEFT"/>- codigo : String<BR ALIGN="LEFT"/>- fechaInicio : LocalDate<BR ALIGN="LEFT"/>- fechaFin : LocalDate<BR ALIGN="LEFT"/>- estado : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Recurso [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Recurso</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idRecurso : Integer<BR ALIGN="LEFT"/>- nombre : String<BR ALIGN="LEFT"/>- categoria : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Rol [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Rol</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idRol : Integer<BR ALIGN="LEFT"/>- nombre : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Seccion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Seccion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idSeccion : Integer<BR ALIGN="LEFT"/>- idCurso : Integer<BR ALIGN="LEFT"/>- codigoCurso : String<BR ALIGN="LEFT"/>- nombreCurso : String<BR ALIGN="LEFT"/>- idPeriodo : Integer<BR ALIGN="LEFT"/>- codigoPeriodo : String<BR ALIGN="LEFT"/>- numero : Integer<BR ALIGN="LEFT"/>- cupoMax : Integer<BR ALIGN="LEFT"/>- cupoMin : Integer<BR ALIGN="LEFT"/>- matriculaProyectada : Integer<BR ALIGN="LEFT"/>- matriculaReal : Integer<BR ALIGN="LEFT"/>- justificacionSobrecupo : String<BR ALIGN="LEFT"/>- estado : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SeccionRiesgoCierre [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>SeccionRiesgoCierre</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idSeccion : Integer<BR ALIGN="LEFT"/>- periodo : String<BR ALIGN="LEFT"/>- codigoCurso : String<BR ALIGN="LEFT"/>- nombreCurso : String<BR ALIGN="LEFT"/>- numeroSeccion : Integer<BR ALIGN="LEFT"/>- matriculaReal : Integer<BR ALIGN="LEFT"/>- cupoMin : Integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SeccionSesionesFaltantes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>SeccionSesionesFaltantes</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idVersion : Integer<BR ALIGN="LEFT"/>- idSeccion : Integer<BR ALIGN="LEFT"/>- codigoCurso : String<BR ALIGN="LEFT"/>- numeroSeccion : Integer<BR ALIGN="LEFT"/>- frecuenciaSemanal : Integer<BR ALIGN="LEFT"/>- sesionesAsignadas : Long<BR ALIGN="LEFT"/>- sesionesFaltantes : Long<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SesionDiasConsecutivos [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>SesionDiasConsecutivos</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idVersion : Integer<BR ALIGN="LEFT"/>- idSeccion : Integer<BR ALIGN="LEFT"/>- codigoCurso : String<BR ALIGN="LEFT"/>- numeroSeccion : Integer<BR ALIGN="LEFT"/>- dia1 : String<BR ALIGN="LEFT"/>- dia2 : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  TipoContrato [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>TipoContrato</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idTipoContrato : Integer<BR ALIGN="LEFT"/>- nombre : String<BR ALIGN="LEFT"/>- horasMin : Integer<BR ALIGN="LEFT"/>- horasMax : Integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Usuario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idUsuario : Integer<BR ALIGN="LEFT"/>- nombreUsuario : String<BR ALIGN="LEFT"/>- contrasena : String<BR ALIGN="LEFT"/>- activo : Boolean<BR ALIGN="LEFT"/>- idRol : Integer<BR ALIGN="LEFT"/>- nombreRol : String<BR ALIGN="LEFT"/>- idDocente : Integer<BR ALIGN="LEFT"/>- nombreDocente : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  VersionHorario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>VersionHorario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idVersion : Integer<BR ALIGN="LEFT"/>- idPeriodo : Integer<BR ALIGN="LEFT"/>- codigoPeriodo : String<BR ALIGN="LEFT"/>- numeroVersion : Integer<BR ALIGN="LEFT"/>- estado : String<BR ALIGN="LEFT"/>- fechaAval : OffsetDateTime<BR ALIGN="LEFT"/>- idDocumentoExterno : String<BR ALIGN="LEFT"/>- idUsuarioAval : Integer<BR ALIGN="LEFT"/>- nombreUsuarioAval : String<BR ALIGN="LEFT"/>- idUsuario : Integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  { rank=same; ApiErrorResponse; Asignacion; CargaDocente; Curso; CursoRecurso; Disponibilidad; }
  ApiErrorResponse -> Docente [style=invis];
  { rank=same; Docente; DocenteCurso; EchoResponse; Espacio; EspacioRecurso; Franja; }
  Docente -> HorarioDetalle [style=invis];
  { rank=same; HorarioDetalle; LogAuditoria; LoginRequest; LoginResponse; ParametroSistema; PeriodoAcademico; }
  HorarioDetalle -> Recurso [style=invis];
  { rank=same; Recurso; Rol; Seccion; SeccionRiesgoCierre; SeccionSesionesFaltantes; SesionDiasConsecutivos; }
  Recurso -> TipoContrato [style=invis];
  { rank=same; TipoContrato; Usuario; VersionHorario; }
  LoginResponse -> Usuario [arrowhead=vee, headlabel="1", constraint=false];
}
