  Curso [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Curso</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- idCurso : Integer<BR ALIGN="LEFT"/>- codigo : String<BR ALIGN="LEFT"/>- nombre : String<BR ALIGN="LEFT"/>- frecuenciaSemanal : Integer<BR ALIGN="LEFT"/>- horasSemanales : Integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
