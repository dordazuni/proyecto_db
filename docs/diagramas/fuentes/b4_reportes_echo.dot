digraph "b4" {
  graph [rankdir=TB, fontname="Liberation Serif", fontsize=16, labelloc=t, label=<<B>Fig. 5. Módulos de reportes y de verificación de conexión (echo)</B><BR/> >, nodesep=0.35, ranksep=0.6, compound=true, newrank=true, pad=0.3 , ranksep=0.7];
  node [shape=plain, fontname="Liberation Serif", fontsize=11];
  edge [fontname="Liberation Serif", fontsize=10, arrowsize=0.8];
  ReporteController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«RestController»<BR/><B>ReporteController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reporteService : ReporteService<BR ALIGN="LEFT"/></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD><TD ALIGN="LEFT">+ ReporteController(reporteService : ReporteService)</TD></TR><TR><TD ALIGN="LEFT">GET /api/reportes/horario</TD><TD ALIGN="LEFT">+ consultarHorario(idVersion : Integer, idDocente : Integer, idEspacio : Integer, idSeccion : Integer, idPeriodo : Integer) : ResponseEntity&lt;List&lt;HorarioDetalle&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/reportes/horario/version/{idVersion}/docente/{idDocente}</TD><TD ALIGN="LEFT">+ consultarHorarioPorDocente(idVersion : int, idDocente : int) : ResponseEntity&lt;List&lt;HorarioDetalle&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/reportes/horario/version/{idVersion}/espacio/{idEspacio}</TD><TD ALIGN="LEFT">+ consultarHorarioPorEspacio(idVersion : int, idEspacio : int) : ResponseEntity&lt;List&lt;HorarioDetalle&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/reportes/horario/version/{idVersion}/seccion/{idSeccion}</TD><TD ALIGN="LEFT">+ consultarHorarioPorSeccion(idVersion : int, idSeccion : int) : ResponseEntity&lt;List&lt;HorarioDetalle&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/reportes/carga-docente</TD><TD ALIGN="LEFT">+ consultarCargaDocente(idVersion : Integer, idDocente : Integer, estadoCarga : String) : ResponseEntity&lt;List&lt;CargaDocente&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/reportes/secciones-riesgo-cierre</TD><TD ALIGN="LEFT">+ consultarSeccionesRiesgoCierre(periodo : String) : ResponseEntity&lt;List&lt;SeccionRiesgoCierre&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/reportes/secciones-sesiones-faltantes</TD><TD ALIGN="LEFT">+ consultarSeccionesSesionesFaltantes(idVersion : Integer) : ResponseEntity&lt;List&lt;SeccionSesionesFaltantes&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/reportes/sesiones-dias-consecutivos</TD><TD ALIGN="LEFT">+ consultarSesionesDiasConsecutivos(idVersion : Integer) : ResponseEntity&lt;List&lt;SesionDiasConsecutivos&gt;&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  ReporteService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Service»<BR/><B>ReporteService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- reporteRepository : ReporteRepository<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ReporteService(reporteRepository : ReporteRepository)<BR ALIGN="LEFT"/>+ consultarHorario(idVersion : Integer, idDocente : Integer, idEspacio : Integer, idSeccion : Integer, idPeriodo : Integer) : List&lt;HorarioDetalle&gt;<BR ALIGN="LEFT"/>+ consultarCargaDocente(idVersion : Integer, idDocente : Integer, estadoCarga : String) : List&lt;CargaDocente&gt;<BR ALIGN="LEFT"/>+ consultarSeccionesRiesgoCierre(periodo : String) : List&lt;SeccionRiesgoCierre&gt;<BR ALIGN="LEFT"/>+ consultarSeccionesSesionesFaltantes(idVersion : Integer) : List&lt;SeccionSesionesFaltantes&gt;<BR ALIGN="LEFT"/>+ consultarSesionesDiasConsecutivos(idVersion : Integer) : List&lt;SesionDiasConsecutivos&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ReporteRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Repository»<BR/><B>ReporteRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dataSource : DataSource<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ReporteRepository(dataSource : DataSource)<BR ALIGN="LEFT"/>+ consultarHorario(idVersion : Integer, idDocente : Integer, idEspacio : Integer, idSeccion : Integer, idPeriodo : Integer) : List&lt;HorarioDetalle&gt;<BR ALIGN="LEFT"/>+ consultarCargaDocente(idVersion : Integer, idDocente : Integer, estadoCarga : String) : List&lt;CargaDocente&gt;<BR ALIGN="LEFT"/>+ consultarSeccionesRiesgoCierre(periodo : String) : List&lt;SeccionRiesgoCierre&gt;<BR ALIGN="LEFT"/>+ consultarSeccionesSesionesFaltantes(idVersion : Integer) : List&lt;SeccionSesionesFaltantes&gt;<BR ALIGN="LEFT"/>+ consultarSesionesDiasConsecutivos(idVersion : Integer) : List&lt;SesionDiasConsecutivos&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ReporteController -> ReporteService [arrowhead=vee];
  ReporteService -> ReporteRepository [arrowhead=vee];
  ReporteRepository -> ext_DataSource [arrowhead=vee];
  EchoController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«RestController»<BR/><B>EchoController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- echoService : EchoService<BR ALIGN="LEFT"/></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD><TD ALIGN="LEFT">+ EchoController(echoService : EchoService)</TD></TR><TR><TD ALIGN="LEFT">GET /api/echo</TD><TD ALIGN="LEFT">+ echo() : ResponseEntity&lt;EchoResponse&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  EchoService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Service»<BR/><B>EchoService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- databaseCheckRepository : DatabaseCheckRepository<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ EchoService(databaseCheckRepository : DatabaseCheckRepository)<BR ALIGN="LEFT"/>+ checkDatabaseConnection() : EchoResponse<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  DatabaseCheckRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Repository»<BR/><B>DatabaseCheckRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dataSource : DataSource<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ DatabaseCheckRepository(dataSource : DataSource)<BR ALIGN="LEFT"/>+ verifyConnection() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EchoController -> EchoService [arrowhead=vee];
  EchoService -> DatabaseCheckRepository [arrowhead=vee];
  DatabaseCheckRepository -> ext_DataSource [arrowhead=vee];
  ext_DataSource [shape=box, style=dashed, fontname="Liberation Serif", fontsize=11, margin="0.12,0.06", label=<«interface»<BR/>javax.sql.DataSource>];
  subgraph cluster_model { label=<<B>model</B>: DTO que usa el módulo (atributos en la Fig. 7)>; fontsize=12; style=solid; margin=10;
    CargaDocente [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>CargaDocente</B></TD></TR></TABLE>>];
    EchoResponse [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>EchoResponse</B></TD></TR></TABLE>>];
    HorarioDetalle [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>HorarioDetalle</B></TD></TR></TABLE>>];
    SeccionRiesgoCierre [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>SeccionRiesgoCierre</B></TD></TR></TABLE>>];
    SeccionSesionesFaltantes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>SeccionSesionesFaltantes</B></TD></TR></TABLE>>];
    SesionDiasConsecutivos [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>SesionDiasConsecutivos</B></TD></TR></TABLE>>];
    { rank=same; CargaDocente; EchoResponse; HorarioDetalle; SeccionRiesgoCierre; SeccionSesionesFaltantes; SesionDiasConsecutivos; }
  }
  ReporteRepository -> HorarioDetalle [style=dashed, arrowhead=vee, lhead=cluster_model, label="«use»"];
  DatabaseCheckRepository -> HorarioDetalle [style=dashed, arrowhead=vee, lhead=cluster_model, label="«use»"];
  ext_DataSource -> CargaDocente [style=invis];
}
