digraph "b5" {
  graph [rankdir=TB, fontname="Liberation Serif", fontsize=16, labelloc=t, label=<<B>Fig. 6. Seguridad, autenticación y configuración</B><BR/> >, nodesep=0.35, ranksep=0.6, compound=true, newrank=true, pad=0.3 , ranksep=0.8];
  node [shape=plain, fontname="Liberation Serif", fontsize=11];
  edge [fontname="Liberation Serif", fontsize=10, arrowsize=0.8];
  SeguridadAuditoriaController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«RestController»<BR/><B>SeguridadAuditoriaController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- seguridadAuditoriaService : SeguridadAuditoriaService<BR ALIGN="LEFT"/></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD><TD ALIGN="LEFT">+ SeguridadAuditoriaController(seguridadAuditoriaService : SeguridadAuditoriaService)</TD></TR><TR><TD ALIGN="LEFT">POST /api/auth/login</TD><TD ALIGN="LEFT">+ login(request : LoginRequest) : ResponseEntity&lt;LoginResponse&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/auth/me</TD><TD ALIGN="LEFT">+ obtenerSesionActual() : ResponseEntity&lt;Usuario&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/auth/refresh</TD><TD ALIGN="LEFT">+ refrescarToken(authHeader : String, ignored : Object) : ResponseEntity&lt;LoginResponse&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/auth/logout</TD><TD ALIGN="LEFT">+ logout(authHeader : String) : ResponseEntity&lt;Void&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/auth/sessions</TD><TD ALIGN="LEFT">+ listarSesionesActivas() : ResponseEntity&lt;List&lt;ActiveSessionDto&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/roles</TD><TD ALIGN="LEFT">+ listarRoles() : ResponseEntity&lt;List&lt;Rol&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/usuarios</TD><TD ALIGN="LEFT">+ listarUsuarios() : ResponseEntity&lt;List&lt;Usuario&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/usuarios/{id}</TD><TD ALIGN="LEFT">+ obtenerUsuario(id : int) : ResponseEntity&lt;Usuario&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/usuarios</TD><TD ALIGN="LEFT">+ crearUsuario(usuario : Usuario) : ResponseEntity&lt;Usuario&gt;</TD></TR><TR><TD ALIGN="LEFT">PUT /api/usuarios/{id}</TD><TD ALIGN="LEFT">+ actualizarUsuario(id : int, usuario : Usuario) : ResponseEntity&lt;Usuario&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/auditoria</TD><TD ALIGN="LEFT">+ listarAuditoria(tablaAfectada : String, accion : String, idUsuario : Integer) : ResponseEntity&lt;List&lt;LogAuditoria&gt;&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  SeguridadAuditoriaService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Service»<BR/><B>SeguridadAuditoriaService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- INVALID_CREDENTIALS_MESSAGE : String</U><BR ALIGN="LEFT"/>- seguridadAuditoriaRepository : SeguridadAuditoriaRepository<BR ALIGN="LEFT"/>- authTokenService : AuthTokenService<BR ALIGN="LEFT"/>- sessionRegistry : UserSessionRegistry<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SeguridadAuditoriaService(seguridadAuditoriaRepository : SeguridadAuditoriaRepository, authTokenService : AuthTokenService, sessionRegistry : UserSessionRegistry)<BR ALIGN="LEFT"/>+ autenticarUsuario(nombreUsuario : String, rawPassword : String) : LoginResponse<BR ALIGN="LEFT"/>+ obtenerUsuarioActualAutenticado() : Usuario<BR ALIGN="LEFT"/>+ refrescarSesion(authHeader : String) : LoginResponse<BR ALIGN="LEFT"/>+ cerrarSesion(authHeader : String)<BR ALIGN="LEFT"/>+ listarSesionesActivas() : List&lt;ActiveSessionDto&gt;<BR ALIGN="LEFT"/>+ listarRoles() : List&lt;Rol&gt;<BR ALIGN="LEFT"/>+ listarUsuarios() : List&lt;Usuario&gt;<BR ALIGN="LEFT"/>+ obtenerUsuarioPorId(idUsuario : int) : Usuario<BR ALIGN="LEFT"/>+ crearUsuario(usuario : Usuario) : Usuario<BR ALIGN="LEFT"/>+ actualizarUsuario(idUsuario : int, usuario : Usuario) : Usuario<BR ALIGN="LEFT"/>+ listarAuditoria(tablaAfectada : String, accion : String, idUsuario : Integer) : List&lt;LogAuditoria&gt;<BR ALIGN="LEFT"/>+ hashPassword(rawPassword : String) : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SeguridadAuditoriaRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Repository»<BR/><B>SeguridadAuditoriaRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dataSource : DataSource<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SeguridadAuditoriaRepository(dataSource : DataSource)<BR ALIGN="LEFT"/>+ listarRoles() : List&lt;Rol&gt;<BR ALIGN="LEFT"/>+ listarUsuarios() : List&lt;Usuario&gt;<BR ALIGN="LEFT"/>+ obtenerUsuarioPorId(idUsuario : int) : Usuario<BR ALIGN="LEFT"/>+ obtenerUsuarioConContrasenaPorNombre(nombreUsuario : String) : Usuario<BR ALIGN="LEFT"/>+ crearUsuario(u : Usuario, passwordHash : String) : Usuario<BR ALIGN="LEFT"/>+ actualizarUsuario(idUsuario : int, u : Usuario, passwordHash : String) : Usuario<BR ALIGN="LEFT"/>+ listarAuditoria(tablaAfectada : String, accion : String, idUsuario : Integer) : List&lt;LogAuditoria&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AuthFilter [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Component»<BR/><B>AuthFilter</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- authTokenService : AuthTokenService<BR ALIGN="LEFT"/>- sessionRegistry : UserSessionRegistry<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ AuthFilter(authTokenService : AuthTokenService, sessionRegistry : UserSessionRegistry)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AuthTokenService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Service»<BR/><B>AuthTokenService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- DEFAULT_EXPIRATION_SECONDS : long</U><BR ALIGN="LEFT"/><U>- MAX_REFRESH_GRACE_SECONDS : long</U><BR ALIGN="LEFT"/><U>- HMAC_ALG : String</U><BR ALIGN="LEFT"/>- secretBytes : byte[]<BR ALIGN="LEFT"/>- expirationSeconds : long<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ AuthTokenService(secret : String, expirationSeconds : long)<BR ALIGN="LEFT"/>+ AuthTokenService(secret : String)<BR ALIGN="LEFT"/>+ generateToken(usuario : Usuario) : String<BR ALIGN="LEFT"/>+ generateToken(usuario : Usuario, expirationInSeconds : long) : String<BR ALIGN="LEFT"/>+ verifyToken(token : String) : Usuario<BR ALIGN="LEFT"/>+ verifyTokenForRefresh(token : String) : Usuario<BR ALIGN="LEFT"/>+ isTokenExpired(token : String) : boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  UserSessionRegistry [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Component»<BR/><B>UserSessionRegistry</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- SESSION_MAX_IDLE : Duration</U><BR ALIGN="LEFT"/>- activeSessionsByUserId : Map&lt;Integer, ActiveSession&gt;<BR ALIGN="LEFT"/>- tokenToUserId : Map&lt;String, Integer&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registerSession(usuario : Usuario, token : String)<BR ALIGN="LEFT"/>+ isUserLoggedIn(idUsuario : Integer) : boolean<BR ALIGN="LEFT"/>+ isTokenActive(token : String) : boolean<BR ALIGN="LEFT"/>+ updateAccessTime(idUsuario : Integer, token : String)<BR ALIGN="LEFT"/>+ removeSession(idUsuario : Integer)<BR ALIGN="LEFT"/>+ removeSessionByToken(token : String)<BR ALIGN="LEFT"/>+ getActiveSessionDtos() : List&lt;ActiveSessionDto&gt;<BR ALIGN="LEFT"/>+ getActiveSessions() : List&lt;ActiveSessionDto&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AuthContextHolder [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5"><B>AuthContextHolder</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- CURRENT_USER : ThreadLocal&lt;Usuario&gt;</U><BR ALIGN="LEFT"/><U>- FORCE_AUTH_LOOKUP : ThreadLocal&lt;Boolean&gt;</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ setCurrentUser(usuario : Usuario)</U><BR ALIGN="LEFT"/><U>+ getCurrentUser() : Usuario</U><BR ALIGN="LEFT"/><U>+ requireCurrentUserId() : int</U><BR ALIGN="LEFT"/><U>+ setForceAuthLookup(force : boolean)</U><BR ALIGN="LEFT"/><U>+ isForceAuthLookup() : boolean</U><BR ALIGN="LEFT"/><U>+ clear()</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  UnauthorizedException [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«exception»<BR/><B>UnauthorizedException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- regla : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ UnauthorizedException(message : String)<BR ALIGN="LEFT"/>+ UnauthorizedException(regla : String, message : String)<BR ALIGN="LEFT"/>+ getRegla() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  DataSourceConfig [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Configuration»<BR/><B>DataSourceConfig</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- adminDataSource : HikariDataSource<BR ALIGN="LEFT"/>- coordinadorDataSource : HikariDataSource<BR ALIGN="LEFT"/>- aprobadorDataSource : HikariDataSource<BR ALIGN="LEFT"/>- docenteDataSource : HikariDataSource<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ DataSourceConfig(jdbcUrl : String, defaultPassword : String, adminUser : String, adminPass : String, coordUser : String, coordPass : String, aprobUser : String, aprobPass : String, docenteUser : String, docentePass : String)<BR ALIGN="LEFT"/>+ dataSource() : DataSource<BR ALIGN="LEFT"/>+ closePools()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CorsConfig [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Component»<BR/><B>CorsConfig</B></TD></TR><TR><TD HEIGHT="8"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ doFilter(req : ServletRequest, res : ServletResponse, chain : FilterChain)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  GlobalExceptionHandler [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«RestControllerAdvice»<BR/><B>GlobalExceptionHandler</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- RULE_PREFIX_PATTERN : Pattern</U><BR ALIGN="LEFT"/><U>- CONSTRAINT_RULE_PATTERN : Pattern</U><BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ handleUnauthorized(ex : UnauthorizedException) : ResponseEntity&lt;ApiErrorResponse&gt;<BR ALIGN="LEFT"/>+ handleSQLException(ex : SQLException) : ResponseEntity&lt;ApiErrorResponse&gt;<BR ALIGN="LEFT"/>+ handleNotFound(ex : NoSuchElementException) : ResponseEntity&lt;ApiErrorResponse&gt;<BR ALIGN="LEFT"/>+ handleBadRequest(ex : IllegalArgumentException) : ResponseEntity&lt;ApiErrorResponse&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ApiHorariosApplication [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«SpringBootApplication»<BR/><B>ApiHorariosApplication</B></TD></TR><TR><TD HEIGHT="8"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ main(args : String[])</U><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ActiveSession [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«record»<BR/><B>ActiveSession</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">idUsuario : Integer<BR ALIGN="LEFT"/>nombreUsuario : String<BR ALIGN="LEFT"/>nombreRol : String<BR ALIGN="LEFT"/>idDocente : Integer<BR ALIGN="LEFT"/>loginTime : Instant<BR ALIGN="LEFT"/>lastAccessTime : Instant<BR ALIGN="LEFT"/>token : String  {@JsonIgnore}<BR ALIGN="LEFT"/>+ toDto() : ActiveSessionDto<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ActiveSessionDto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«record»<BR/><B>ActiveSessionDto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">idUsuario : Integer<BR ALIGN="LEFT"/>nombreUsuario : String<BR ALIGN="LEFT"/>nombreRol : String<BR ALIGN="LEFT"/>idDocente : Integer<BR ALIGN="LEFT"/>loginTime : Instant<BR ALIGN="LEFT"/>lastAccessTime : Instant<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RoleAwareDataSource [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«clase anidada privada»<BR/><B>RoleAwareDataSource</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- poolsByRole : Map&lt;String, DataSource&gt;<BR ALIGN="LEFT"/>- authLookupDataSource : DataSource<BR ALIGN="LEFT"/>+ getConnection() : Connection<BR ALIGN="LEFT"/>+ getConnection(username : String, password : String) : Connection<BR ALIGN="LEFT"/>- resolveTargetDataSource() : DataSource<BR ALIGN="LEFT"/>- wrapTransactionalConnection(rawConn : Connection) : Connection<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ext_DataSource [shape=box, style=dashed, fontname="Liberation Serif", fontsize=11, margin="0.12,0.06", label=<«interface»<BR/>javax.sql.DataSource>];
  ext_Hikari [shape=box, style=dashed, fontname="Liberation Serif", fontsize=11, margin="0.12,0.06", label=<HikariDataSource>];
  ext_Filter [shape=box, style=dashed, fontname="Liberation Serif", fontsize=11, margin="0.12,0.06", label=<«interface»<BR/>jakarta.servlet.Filter>];
  ext_OPRF [shape=box, style=dashed, fontname="Liberation Serif", fontsize=11, margin="0.12,0.06", label=<OncePerRequestFilter>];
  ext_RTE [shape=box, style=dashed, fontname="Liberation Serif", fontsize=11, margin="0.12,0.06", label=<RuntimeException>];
  SeguridadAuditoriaController -> SeguridadAuditoriaService [arrowhead=vee];
  SeguridadAuditoriaService -> SeguridadAuditoriaRepository [arrowhead=vee];
  SeguridadAuditoriaService -> AuthTokenService [arrowhead=vee];
  SeguridadAuditoriaService -> UserSessionRegistry [arrowhead=vee];
  SeguridadAuditoriaService -> AuthContextHolder [style=dashed, arrowhead=vee];
  SeguridadAuditoriaController -> UserSessionRegistry [style=dashed, arrowhead=vee];
  SeguridadAuditoriaRepository -> ext_DataSource [arrowhead=vee];
  AuthFilter -> AuthTokenService [arrowhead=vee];
  AuthFilter -> UserSessionRegistry [arrowhead=vee];
  AuthFilter -> AuthContextHolder [style=dashed, arrowhead=vee];
  AuthFilter -> ext_OPRF [arrowhead=onormal, arrowsize=1.1];
  UnauthorizedException -> ext_RTE [arrowhead=onormal, arrowsize=1.1];
  CorsConfig -> ext_Filter [style=dashed, arrowhead=onormal, arrowsize=1.1];
  UserSessionRegistry -> ActiveSession [dir=back, arrowtail=diamond, arrowsize=1.0];
  UserSessionRegistry -> ActiveSessionDto [dir=back, arrowtail=diamond, arrowsize=1.0];
  DataSourceConfig -> RoleAwareDataSource [dir=back, arrowtail=diamond, arrowsize=1.0];
  DataSourceConfig -> ext_Hikari [dir=back, arrowtail=diamond, arrowsize=1.0, headlabel="4"];
  RoleAwareDataSource -> ext_DataSource [style=dashed, arrowhead=onormal, arrowsize=1.1];
  RoleAwareDataSource -> AuthContextHolder [style=dashed, arrowhead=vee];
  GlobalExceptionHandler -> UnauthorizedException [style=dashed, arrowhead=vee];
  AuthTokenService -> UnauthorizedException [style=dashed, arrowhead=vee];
  AuthContextHolder -> UnauthorizedException [style=dashed, arrowhead=vee];
}
