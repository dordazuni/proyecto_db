digraph "b3" {
  graph [rankdir=TB, fontname="Liberation Serif", fontsize=16, labelloc=t, label=<<B>Fig. 4. Módulo de programación (versiones y asignaciones)</B><BR/> >, nodesep=0.35, ranksep=0.6, compound=true, newrank=true, pad=0.3 , ranksep=0.7];
  node [shape=plain, fontname="Liberation Serif", fontsize=11];
  edge [fontname="Liberation Serif", fontsize=10, arrowsize=0.8];
  ProgramacionController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«RestController»<BR/><B>ProgramacionController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- programacionService : ProgramacionService<BR ALIGN="LEFT"/></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD><TD ALIGN="LEFT">+ ProgramacionController(programacionService : ProgramacionService)</TD></TR><TR><TD ALIGN="LEFT">GET /api/versiones</TD><TD ALIGN="LEFT">+ listarVersiones(idPeriodo : Integer) : ResponseEntity&lt;List&lt;VersionHorario&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/versiones/{id}</TD><TD ALIGN="LEFT">+ obtenerVersion(id : int) : ResponseEntity&lt;VersionHorario&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/versiones</TD><TD ALIGN="LEFT">+ crearVersion(version : VersionHorario) : ResponseEntity&lt;VersionHorario&gt;</TD></TR><TR><TD ALIGN="LEFT">PATCH /api/versiones/{id}/enviar-aprobacion</TD><TD ALIGN="LEFT">+ enviarAAprobacion(id : int) : ResponseEntity&lt;VersionHorario&gt;</TD></TR><TR><TD ALIGN="LEFT">PATCH /api/versiones/{id}/avalar</TD><TD ALIGN="LEFT">+ avalarVersion(id : int) : ResponseEntity&lt;VersionHorario&gt;</TD></TR><TR><TD ALIGN="LEFT">PATCH /api/versiones/{id}/devolver</TD><TD ALIGN="LEFT">+ devolverVersion(id : int) : ResponseEntity&lt;VersionHorario&gt;</TD></TR><TR><TD ALIGN="LEFT">PATCH /api/versiones/{id}/sincronizar</TD><TD ALIGN="LEFT">+ sincronizarVersion(id : int, body : VersionHorario) : ResponseEntity&lt;VersionHorario&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/versiones/{id}/clonar</TD><TD ALIGN="LEFT">+ clonarVersion(id : int) : ResponseEntity&lt;VersionHorario&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/asignaciones</TD><TD ALIGN="LEFT">+ listarAsignaciones(idVersion : Integer) : ResponseEntity&lt;List&lt;Asignacion&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/asignaciones/{id}</TD><TD ALIGN="LEFT">+ obtenerAsignacion(id : int) : ResponseEntity&lt;Asignacion&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/asignaciones</TD><TD ALIGN="LEFT">+ crearAsignacion(asignacion : Asignacion) : ResponseEntity&lt;Asignacion&gt;</TD></TR><TR><TD ALIGN="LEFT">PUT /api/asignaciones/{id}</TD><TD ALIGN="LEFT">+ actualizarAsignacion(id : int, asignacion : Asignacion) : ResponseEntity&lt;Asignacion&gt;</TD></TR><TR><TD ALIGN="LEFT">DELETE /api/asignaciones/{id}</TD><TD ALIGN="LEFT">+ eliminarAsignacion(id : int) : ResponseEntity&lt;Map&lt;String, String&gt;&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  ProgramacionService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Service»<BR/><B>ProgramacionService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- programacionRepository : ProgramacionRepository<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ProgramacionService(programacionRepository : ProgramacionRepository)<BR ALIGN="LEFT"/>+ listarVersiones(idPeriodo : Integer) : List&lt;VersionHorario&gt;<BR ALIGN="LEFT"/>+ obtenerVersionPorId(idVersion : int) : VersionHorario<BR ALIGN="LEFT"/>+ crearVersion(version : VersionHorario) : VersionHorario<BR ALIGN="LEFT"/>+ enviarAAprobacion(idVersion : int) : VersionHorario<BR ALIGN="LEFT"/>+ avalarVersion(idVersion : int) : VersionHorario<BR ALIGN="LEFT"/>+ devolverVersion(idVersion : int) : VersionHorario<BR ALIGN="LEFT"/>+ sincronizarVersion(idVersion : int, idDocumentoExterno : String) : VersionHorario<BR ALIGN="LEFT"/>+ clonarVersion(idVersionOrigen : int) : VersionHorario<BR ALIGN="LEFT"/>+ listarAsignaciones(idVersion : Integer) : List&lt;Asignacion&gt;<BR ALIGN="LEFT"/>+ obtenerAsignacionPorId(idAsignacion : int) : Asignacion<BR ALIGN="LEFT"/>+ crearAsignacion(asignacion : Asignacion) : Asignacion<BR ALIGN="LEFT"/>+ actualizarAsignacion(idAsignacion : int, asignacion : Asignacion) : Asignacion<BR ALIGN="LEFT"/>+ eliminarAsignacion(idAsignacion : int)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ProgramacionRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Repository»<BR/><B>ProgramacionRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dataSource : DataSource<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ProgramacionRepository(dataSource : DataSource)<BR ALIGN="LEFT"/>+ listarVersiones(idPeriodo : Integer) : List&lt;VersionHorario&gt;<BR ALIGN="LEFT"/>+ obtenerVersionPorId(idVersion : int) : VersionHorario<BR ALIGN="LEFT"/>+ crearVersion(v : VersionHorario, idUsuario : int) : VersionHorario<BR ALIGN="LEFT"/>+ cambiarEstadoVersion(idVersion : int, nuevoEstado : String, idUsuario : int) : VersionHorario<BR ALIGN="LEFT"/>+ sincronizarVersion(idVersion : int, idDocumentoExterno : String, idUsuario : int) : VersionHorario<BR ALIGN="LEFT"/>+ clonarVersion(idVersionOrigen : int, idUsuario : int) : VersionHorario<BR ALIGN="LEFT"/>+ listarAsignaciones(idVersion : Integer) : List&lt;Asignacion&gt;<BR ALIGN="LEFT"/>+ obtenerAsignacionPorId(idAsignacion : int) : Asignacion<BR ALIGN="LEFT"/>+ crearAsignacion(a : Asignacion, idUsuario : int) : Asignacion<BR ALIGN="LEFT"/>+ actualizarAsignacion(idAsignacion : int, a : Asignacion, idUsuario : int) : Asignacion<BR ALIGN="LEFT"/>+ eliminarAsignacion(idAsignacion : int, idUsuario : int)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ProgramacionController -> ProgramacionService [arrowhead=vee];
  ProgramacionService -> ProgramacionRepository [arrowhead=vee];
  ProgramacionRepository -> ext_DataSource [arrowhead=vee];
  AuthContextHolder [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5"><B>AuthContextHolder</B></TD></TR></TABLE>>];
  ProgramacionService -> AuthContextHolder [style=dashed, arrowhead=vee];
  ProgramacionRepository -> AuthContextHolder [style=dashed, arrowhead=vee];
  ext_DataSource [shape=box, style=dashed, fontname="Liberation Serif", fontsize=11, margin="0.12,0.06", label=<«interface»<BR/>javax.sql.DataSource>];
  subgraph cluster_model { label=<<B>model</B>: DTO que usa el módulo (atributos en la Fig. 7)>; fontsize=12; style=solid; margin=10;
    Asignacion [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Asignacion</B></TD></TR></TABLE>>];
    VersionHorario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>VersionHorario</B></TD></TR></TABLE>>];
    { rank=same; Asignacion; VersionHorario; }
  }
  ProgramacionRepository -> VersionHorario [style=dashed, arrowhead=vee, lhead=cluster_model, label="«use»"];
  ext_DataSource -> Asignacion [style=invis];
}
