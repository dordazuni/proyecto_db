digraph "b1" {
  graph [rankdir=TB, fontname="Liberation Serif", fontsize=16, labelloc=t, label=<<B>Fig. 2. Módulo de catálogos: controlador, servicio y repositorio</B><BR/> >, nodesep=0.35, ranksep=0.6, compound=true, newrank=true, pad=0.3 , ranksep=0.7];
  node [shape=plain, fontname="Liberation Serif", fontsize=11];
  edge [fontname="Liberation Serif", fontsize=10, arrowsize=0.8];
  CatalogoController [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«RestController»<BR/><B>CatalogoController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- catalogoService : CatalogoService<BR ALIGN="LEFT"/></TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD><TD ALIGN="LEFT">+ CatalogoController(catalogoService : CatalogoService)</TD></TR><TR><TD ALIGN="LEFT">GET /api/periodos</TD><TD ALIGN="LEFT">+ listarPeriodos() : ResponseEntity&lt;List&lt;PeriodoAcademico&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/periodos/{id}</TD><TD ALIGN="LEFT">+ obtenerPeriodo(id : int) : ResponseEntity&lt;PeriodoAcademico&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/periodos</TD><TD ALIGN="LEFT">+ crearPeriodo(periodo : PeriodoAcademico) : ResponseEntity&lt;PeriodoAcademico&gt;</TD></TR><TR><TD ALIGN="LEFT">PUT /api/periodos/{id}</TD><TD ALIGN="LEFT">+ actualizarPeriodo(id : int, periodo : PeriodoAcademico) : ResponseEntity&lt;PeriodoAcademico&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/tipos-contrato</TD><TD ALIGN="LEFT">+ listarTiposContrato() : ResponseEntity&lt;List&lt;TipoContrato&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/docentes</TD><TD ALIGN="LEFT">+ listarDocentes() : ResponseEntity&lt;List&lt;Docente&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/docentes/{id}</TD><TD ALIGN="LEFT">+ obtenerDocente(id : int) : ResponseEntity&lt;Docente&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/integracion/docentes</TD><TD ALIGN="LEFT">+ crearDocente(docente : Docente) : ResponseEntity&lt;Docente&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/espacios</TD><TD ALIGN="LEFT">+ listarEspacios() : ResponseEntity&lt;List&lt;Espacio&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/espacios/{id}</TD><TD ALIGN="LEFT">+ obtenerEspacio(id : int) : ResponseEntity&lt;Espacio&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/integracion/espacios</TD><TD ALIGN="LEFT">+ crearEspacio(espacio : Espacio) : ResponseEntity&lt;Espacio&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/recursos</TD><TD ALIGN="LEFT">+ listarRecursos() : ResponseEntity&lt;List&lt;Recurso&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/recursos</TD><TD ALIGN="LEFT">+ crearRecurso(recurso : Recurso) : ResponseEntity&lt;Recurso&gt;</TD></TR><TR><TD ALIGN="LEFT">PUT /api/recursos/{id}</TD><TD ALIGN="LEFT">+ actualizarRecurso(id : int, recurso : Recurso) : ResponseEntity&lt;Recurso&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/espacios/{idEspacio}/recursos</TD><TD ALIGN="LEFT">+ listarRecursosDeEspacio(idEspacio : int) : ResponseEntity&lt;List&lt;EspacioRecurso&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/espacios/{idEspacio}/recursos</TD><TD ALIGN="LEFT">+ asignarRecursoAEspacio(idEspacio : int, body : EspacioRecurso) : ResponseEntity&lt;EspacioRecurso&gt;</TD></TR><TR><TD ALIGN="LEFT">PUT /api/espacios/{idEspacio}/recursos/{idRecurso}</TD><TD ALIGN="LEFT">+ actualizarRecursoDeEspacio(idEspacio : int, idRecurso : int, body : EspacioRecurso) : ResponseEntity&lt;EspacioRecurso&gt;</TD></TR><TR><TD ALIGN="LEFT">DELETE /api/espacios/{idEspacio}/recursos/{idRecurso}</TD><TD ALIGN="LEFT">+ eliminarRecursoDeEspacio(idEspacio : int, idRecurso : int) : ResponseEntity&lt;Map&lt;String, String&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/cursos</TD><TD ALIGN="LEFT">+ listarCursos() : ResponseEntity&lt;List&lt;Curso&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/cursos/{id}</TD><TD ALIGN="LEFT">+ obtenerCurso(id : int) : ResponseEntity&lt;Curso&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/cursos</TD><TD ALIGN="LEFT">+ crearCurso(curso : Curso) : ResponseEntity&lt;Curso&gt;</TD></TR><TR><TD ALIGN="LEFT">PUT /api/cursos/{id}</TD><TD ALIGN="LEFT">+ actualizarCurso(id : int, curso : Curso) : ResponseEntity&lt;Curso&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/cursos/{idCurso}/recursos</TD><TD ALIGN="LEFT">+ listarRecursosDeCurso(idCurso : int) : ResponseEntity&lt;List&lt;CursoRecurso&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/cursos/{idCurso}/recursos</TD><TD ALIGN="LEFT">+ agregarRecursoACurso(idCurso : int, body : CursoRecurso) : ResponseEntity&lt;CursoRecurso&gt;</TD></TR><TR><TD ALIGN="LEFT">DELETE /api/cursos/{idCurso}/recursos/{idRecurso}</TD><TD ALIGN="LEFT">+ eliminarRecursoDeCurso(idCurso : int, idRecurso : int) : ResponseEntity&lt;Map&lt;String, String&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/docentes/{idDocente}/cursos</TD><TD ALIGN="LEFT">+ listarCursosPorDocente(idDocente : int) : ResponseEntity&lt;List&lt;DocenteCurso&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/cursos/{idCurso}/docentes</TD><TD ALIGN="LEFT">+ listarDocentesPorCurso(idCurso : int) : ResponseEntity&lt;List&lt;DocenteCurso&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/docentes/{idDocente}/cursos</TD><TD ALIGN="LEFT">+ habilitarDocenteEnCurso(idDocente : int, body : DocenteCurso) : ResponseEntity&lt;DocenteCurso&gt;</TD></TR><TR><TD ALIGN="LEFT">DELETE /api/docentes/{idDocente}/cursos/{idCurso}</TD><TD ALIGN="LEFT">+ deshabilitarDocenteEnCurso(idDocente : int, idCurso : int) : ResponseEntity&lt;Map&lt;String, String&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/franjas</TD><TD ALIGN="LEFT">+ listarFranjas() : ResponseEntity&lt;List&lt;Franja&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/franjas/{id}</TD><TD ALIGN="LEFT">+ obtenerFranja(id : int) : ResponseEntity&lt;Franja&gt;</TD></TR><TR><TD ALIGN="LEFT">POST /api/franjas</TD><TD ALIGN="LEFT">+ crearFranja(franja : Franja) : ResponseEntity&lt;Franja&gt;</TD></TR><TR><TD ALIGN="LEFT">PUT /api/franjas/{id}</TD><TD ALIGN="LEFT">+ actualizarFranja(id : int, franja : Franja) : ResponseEntity&lt;Franja&gt;</TD></TR><TR><TD ALIGN="LEFT">GET /api/parametros</TD><TD ALIGN="LEFT">+ listarParametros() : ResponseEntity&lt;List&lt;ParametroSistema&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">PUT /api/parametros/{clave}</TD><TD ALIGN="LEFT">+ actualizarParametro(clave : String, parametro : ParametroSistema) : ResponseEntity&lt;ParametroSistema&gt;</TD></TR></TABLE></TD></TR></TABLE>>];
  CatalogoService [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Service»<BR/><B>CatalogoService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- catalogoRepository : CatalogoRepository<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CatalogoService(catalogoRepository : CatalogoRepository)<BR ALIGN="LEFT"/>+ listarPeriodos() : List&lt;PeriodoAcademico&gt;<BR ALIGN="LEFT"/>+ obtenerPeriodoPorId(idPeriodo : int) : PeriodoAcademico<BR ALIGN="LEFT"/>+ crearPeriodo(periodo : PeriodoAcademico) : PeriodoAcademico<BR ALIGN="LEFT"/>+ actualizarPeriodo(idPeriodo : int, periodo : PeriodoAcademico) : PeriodoAcademico<BR ALIGN="LEFT"/>+ listarTiposContrato() : List&lt;TipoContrato&gt;<BR ALIGN="LEFT"/>+ listarDocentes() : List&lt;Docente&gt;<BR ALIGN="LEFT"/>+ obtenerDocentePorId(idDocente : int) : Docente<BR ALIGN="LEFT"/>+ crearDocente(docente : Docente) : Docente<BR ALIGN="LEFT"/>+ listarEspacios() : List&lt;Espacio&gt;<BR ALIGN="LEFT"/>+ obtenerEspacioPorId(idEspacio : int) : Espacio<BR ALIGN="LEFT"/>+ crearEspacio(espacio : Espacio) : Espacio<BR ALIGN="LEFT"/>+ listarRecursos() : List&lt;Recurso&gt;<BR ALIGN="LEFT"/>+ crearRecurso(recurso : Recurso) : Recurso<BR ALIGN="LEFT"/>+ actualizarRecurso(idRecurso : int, recurso : Recurso) : Recurso<BR ALIGN="LEFT"/>+ listarRecursosPorEspacio(idEspacio : int) : List&lt;EspacioRecurso&gt;<BR ALIGN="LEFT"/>+ asignarRecursoAEspacio(idEspacio : int, idRecurso : int, cantidad : int) : EspacioRecurso<BR ALIGN="LEFT"/>+ eliminarRecursoDeEspacio(idEspacio : int, idRecurso : int)<BR ALIGN="LEFT"/>+ listarCursos() : List&lt;Curso&gt;<BR ALIGN="LEFT"/>+ obtenerCursoPorId(idCurso : int) : Curso<BR ALIGN="LEFT"/>+ crearCurso(curso : Curso) : Curso<BR ALIGN="LEFT"/>+ actualizarCurso(idCurso : int, curso : Curso) : Curso<BR ALIGN="LEFT"/>+ listarRecursosDeCurso(idCurso : int) : List&lt;CursoRecurso&gt;<BR ALIGN="LEFT"/>+ agregarRecursoACurso(idCurso : int, idRecurso : int) : CursoRecurso<BR ALIGN="LEFT"/>+ eliminarRecursoDeCurso(idCurso : int, idRecurso : int)<BR ALIGN="LEFT"/>+ listarCursosPorDocente(idDocente : int) : List&lt;DocenteCurso&gt;<BR ALIGN="LEFT"/>+ listarDocentesPorCurso(idCurso : int) : List&lt;DocenteCurso&gt;<BR ALIGN="LEFT"/>+ habilitarDocenteEnCurso(idDocente : int, idCurso : int) : DocenteCurso<BR ALIGN="LEFT"/>+ deshabilitarDocenteEnCurso(idDocente : int, idCurso : int)<BR ALIGN="LEFT"/>+ listarFranjas() : List&lt;Franja&gt;<BR ALIGN="LEFT"/>+ obtenerFranjaPorId(idFranja : int) : Franja<BR ALIGN="LEFT"/>+ crearFranja(franja : Franja) : Franja<BR ALIGN="LEFT"/>+ actualizarFranja(idFranja : int, franja : Franja) : Franja<BR ALIGN="LEFT"/>+ listarParametros() : List&lt;ParametroSistema&gt;<BR ALIGN="LEFT"/>+ actualizarParametro(clave : String, parametro : ParametroSistema) : ParametroSistema<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CatalogoRepository [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«Repository»<BR/><B>CatalogoRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dataSource : DataSource<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ CatalogoRepository(dataSource : DataSource)<BR ALIGN="LEFT"/>+ listarPeriodos() : List&lt;PeriodoAcademico&gt;<BR ALIGN="LEFT"/>+ obtenerPeriodoPorId(idPeriodo : int) : PeriodoAcademico<BR ALIGN="LEFT"/>+ crearPeriodo(p : PeriodoAcademico) : PeriodoAcademico<BR ALIGN="LEFT"/>+ actualizarPeriodo(idPeriodo : int, p : PeriodoAcademico) : PeriodoAcademico<BR ALIGN="LEFT"/>+ listarTiposContrato() : List&lt;TipoContrato&gt;<BR ALIGN="LEFT"/>+ listarDocentes() : List&lt;Docente&gt;<BR ALIGN="LEFT"/>+ obtenerDocentePorId(idDocente : int) : Docente<BR ALIGN="LEFT"/>+ crearDocente(d : Docente) : Docente<BR ALIGN="LEFT"/>+ listarEspacios() : List&lt;Espacio&gt;<BR ALIGN="LEFT"/>+ obtenerEspacioPorId(idEspacio : int) : Espacio<BR ALIGN="LEFT"/>+ crearEspacio(e : Espacio) : Espacio<BR ALIGN="LEFT"/>+ listarRecursos() : List&lt;Recurso&gt;<BR ALIGN="LEFT"/>+ crearRecurso(r : Recurso) : Recurso<BR ALIGN="LEFT"/>+ actualizarRecurso(idRecurso : int, r : Recurso) : Recurso<BR ALIGN="LEFT"/>+ listarRecursosPorEspacio(idEspacio : int) : List&lt;EspacioRecurso&gt;<BR ALIGN="LEFT"/>+ asignarRecursoAEspacio(idEspacio : int, idRecurso : int, cantidad : int) : EspacioRecurso<BR ALIGN="LEFT"/>+ eliminarRecursoDeEspacio(idEspacio : int, idRecurso : int)<BR ALIGN="LEFT"/>+ listarCursos() : List&lt;Curso&gt;<BR ALIGN="LEFT"/>+ obtenerCursoPorId(idCurso : int) : Curso<BR ALIGN="LEFT"/>+ crearCurso(c : Curso) : Curso<BR ALIGN="LEFT"/>+ actualizarCurso(idCurso : int, c : Curso) : Curso<BR ALIGN="LEFT"/>+ listarRecursosDeCurso(idCurso : int) : List&lt;CursoRecurso&gt;<BR ALIGN="LEFT"/>+ agregarRecursoACurso(idCurso : int, idRecurso : int) : CursoRecurso<BR ALIGN="LEFT"/>+ eliminarRecursoDeCurso(idCurso : int, idRecurso : int)<BR ALIGN="LEFT"/>+ listarCursosPorDocente(idDocente : int) : List&lt;DocenteCurso&gt;<BR ALIGN="LEFT"/>+ listarDocentesPorCurso(idCurso : int) : List&lt;DocenteCurso&gt;<BR ALIGN="LEFT"/>+ habilitarDocenteEnCurso(idDocente : int, idCurso : int) : DocenteCurso<BR ALIGN="LEFT"/>+ deshabilitarDocenteEnCurso(idDocente : int, idCurso : int)<BR ALIGN="LEFT"/>+ listarFranjas() : List&lt;Franja&gt;<BR ALIGN="LEFT"/>+ crearFranja(f : Franja) : Franja<BR ALIGN="LEFT"/>+ actualizarFranja(idFranja : int, f : Franja) : Franja<BR ALIGN="LEFT"/>+ obtenerFranjaPorId(idFranja : int) : Franja<BR ALIGN="LEFT"/>+ listarParametros() : List&lt;ParametroSistema&gt;<BR ALIGN="LEFT"/>+ actualizarParametro(clave : String, p : ParametroSistema) : ParametroSistema<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CatalogoController -> CatalogoService [arrowhead=vee];
  CatalogoService -> CatalogoRepository [arrowhead=vee];
  CatalogoRepository -> ext_DataSource [arrowhead=vee];
  ext_DataSource [shape=box, style=dashed, fontname="Liberation Serif", fontsize=11, margin="0.12,0.06", label=<«interface»<BR/>javax.sql.DataSource>];
  subgraph cluster_model { label=<<B>model</B>: DTO que usa el módulo (atributos en la Fig. 7)>; fontsize=12; style=solid; margin=10;
    Curso [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Curso</B></TD></TR></TABLE>>];
    CursoRecurso [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>CursoRecurso</B></TD></TR></TABLE>>];
    Docente [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Docente</B></TD></TR></TABLE>>];
    DocenteCurso [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>DocenteCurso</B></TD></TR></TABLE>>];
    Espacio [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Espacio</B></TD></TR></TABLE>>];
    EspacioRecurso [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>EspacioRecurso</B></TD></TR></TABLE>>];
    Franja [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Franja</B></TD></TR></TABLE>>];
    ParametroSistema [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>ParametroSistema</B></TD></TR></TABLE>>];
    PeriodoAcademico [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>PeriodoAcademico</B></TD></TR></TABLE>>];
    Recurso [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>Recurso</B></TD></TR></TABLE>>];
    TipoContrato [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD CELLPADDING="5">«DTO»<BR/><B>TipoContrato</B></TD></TR></TABLE>>];
    { rank=same; Curso; CursoRecurso; Docente; DocenteCurso; Espacio; EspacioRecurso; }
    Curso -> Franja [style=invis];
    { rank=same; Franja; ParametroSistema; PeriodoAcademico; Recurso; TipoContrato; }
  }
  CatalogoRepository -> Docente [style=dashed, arrowhead=vee, lhead=cluster_model, label="«use»"];
  ext_DataSource -> Curso [style=invis];
}
